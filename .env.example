# ── Nexa AI ──────────────────────────────────────────────────────────────
# Get a free key: https://aistudio.google.com/apikey
# Never commit a real key. Copy this file to `.env` (git-ignored).
GEMINI_API_KEY=

# Force a specific model. Leave blank for auto-discovery (recommended —
# Nexa resolves the newest available Flash model at runtime).
GEMINI_MODEL=

# Optional: server port. Vite dev proxy expects 8787.
PORT=8787
